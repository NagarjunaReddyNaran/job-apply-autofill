{
  "manifest_version": 3,
  "name": "JobApply Autofill",
  "version": "0.5.0",
  "description": "Detects and fills common fields on job application forms. Never auto-submits. Asks for permission per-site rather than on install.",
  "permissions": ["storage", "scripting", "activeTab", "tabs", "webNavigation"],
  "optional_host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "JobApply Autofill"
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "options_page": "options/options.html"
}
